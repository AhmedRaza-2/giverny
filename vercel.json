{
  "cleanUrls": true,
  "analytics": {
    "enable": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(assets|data)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|llms.txt|llms-full.txt|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/claude-skills",
      "destination": "/api/page?type=hub"
    },
    {
      "source": "/claude-skills/:section",
      "destination": "/api/page?type=section&section=:section"
    },
    {
      "source": "/claude-skills/:section/:cat",
      "destination": "/api/page?type=cat&section=:section&cat=:cat"
    },
    {
      "source": "/skills/:id",
      "destination": "/api/page?type=skill&id=:id"
    }
  ]
}